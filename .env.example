PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dropmai?schema=public"
# Persistence on: DROPMAI_USE_MOCK=false + real DATABASE_URL
DROPMAI_USE_MOCK="true"
DROPMAI_FORCE_DB="false"
# Comma-separated. Code always also allows localhost:3000 + https://dropmai.vercel.app
CORS_ORIGINS="http://localhost:3000,https://dropmai.vercel.app"

# Signed session cookies (dm1.<payload>.<hmac>). Required in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Xnamai supplier (preferred: Mercos_Adaptor)
MERCOS_ADAPTOR_URL="https://mercosadaptor.onrender.com"
MERCOS_ADAPTOR_API_KEY=""

# Fallback: Xnamai BI Backend
XNAMAI_BI_URL="https://xnamai-bi-backend.onrender.com"
XNAMAI_BI_API_KEY=""
XNAMAI_BI_BEARER=""

# Public URLs (OAuth redirects + cookie SameSite)
FRONTEND_URL="https://dropmai.vercel.app"
PUBLIC_API_URL="https://dropmai-backend.onrender.com"

# Google OAuth (required for real Google login)
# Authorized redirect URI in Google Cloud must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://dropmai-backend.onrender.com/api/v1/auth/google/callback"
